# PostgreSQL connection string
DATABASE_URL="postgresql://nexora:nexora@localhost:5432/nexora?schema=public"

# Where uploaded files (avatars) are stored. Relative paths resolve from the project root.
UPLOAD_DIR="./uploads"

# Optional. Public origin of the app (e.g. https://chat.example.com). Requests that change
# data are rejected unless they come from this origin or from the host serving the app.
# APP_ORIGIN=""

# Optional session cookie overrides. Defaults: SameSite=lax, Secure only in production.
# Use "none" + "true" only if the app must work inside a cross-site iframe over HTTPS.
# SESSION_COOKIE_SAMESITE="lax"
# SESSION_COOKIE_SECURE="false"

# Optional, development only. Extra hostnames allowed to load the dev server (comma-separated),
# for example a tunnel or LAN address. localhost always works.
# DEV_ALLOWED_ORIGINS="127.0.0.1,*.tunnel.example.com"
